# Runtime mode: development | production
ENV=development

# API Key cho Gemini (Không bắt buộc nếu người dùng tự cấu hình từ frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here


# PostgreSQL (Supabase) - local SQLite: comment/xóa dòng này để dùng mặc định
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.yuymlherezqfwicfnhhp.supabase.co:5432/postgres

# Cấu hình CORS (Phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Cấu hình Port và Host (Dùng cho uvicorn tại local)
PORT=8000
HOST=0.0.0.0

# Admin Secret để quản lý API Key
ADMIN_SECRET=admin_secret_key_here

# Debug snapshots: chỉ bật local khi cần soi prompt/snapshot
DEBUG_SNAPSHOTS=false

# Series flow: tắt mặc định để cô lập sinh chuỗi khỏi luồng sinh đơn
ENABLE_SERIES_FLOW=false

# Startup migration: bật mặc định để giữ hành vi deploy hiện tại; tắt nếu platform chạy Alembic riêng
AUTO_RUN_MIGRATIONS=true

# Proxy để trích xuất phụ đề YouTube tránh bị chặn IP (Ví dụ: http://username:password@proxy_host:port)
# PROXY_URL=http://user:pass@host:port
